{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git",
      ".git/**",
      "**/.git/**",
      ".firebase",
      ".firebase/**",
      "**/.firebase/**",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".gitignore",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
