rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? me().role : ''; }
    function distributorId() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? me().distributorId : ''; }
    function admin() {
      return signedIn() && (request.auth.token.admin == true ||
        request.auth.token.email == 'admin@gasbridge.com');
    }
    function adminOrDistributorProfile(id) {
      return admin() || (role() == 'distributor' && distributorId() == id);
    }
    function distributorFor(id) { return admin() || (role() == 'distributor' && distributorId() == id); }
    function cleanProfile() { return !('password' in request.resource.data) && !('passwordHash' in request.resource.data); }
    function profileOwnerUnchanged() {
      return request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.approvedBy == resource.data.approvedBy &&
        request.resource.data.distributorId == resource.data.distributorId;
    }
    function assignedAgentExists(agentId) {
      return exists(/databases/$(database)/documents/deliveryAgents/$(agentId)) &&
        get(/databases/$(database)/documents/deliveryAgents/$(agentId)).data.status == 'approved' &&
        get(/databases/$(database)/documents/deliveryAgents/$(agentId)).data.distributorId == distributorId();
    }
    function assignedAgentDetailsMatch() {
      let agent = get(/databases/$(database)/documents/deliveryAgents/$(request.resource.data.deliveryAgentId)).data;
      return agent.status == 'approved' && agent.distributorId == resource.data.distributorId &&
        request.resource.data.deliveryAgentName == agent.name &&
        request.resource.data.deliveryAgentMobile == agent.mobile &&
        request.resource.data.deliveryAgentVehicleNumber == agent.vehicleNumber;
    }
    function validInventorySection(section) {
      return section is map && section.available is int && section.available >= 0 &&
        section.reserved is int && section.reserved >= 0;
    }
    function validInventoryRecord(id) {
      return request.resource.data.distributorId == id &&
        validInventorySection(request.resource.data.domestic) &&
        validInventorySection(request.resource.data.commercial);
    }
    function distributorNotificationTarget() {
      return role() == 'distributor' && (
        (request.resource.data.role == 'customer' &&
          exists(/databases/$(database)/documents/customers/$(request.resource.data.recipientUserId)) &&
          get(/databases/$(database)/documents/customers/$(request.resource.data.recipientUserId)).data.distributorId == distributorId()) ||
        (request.resource.data.role == 'agent' &&
          exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)) &&
          get(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)).data.role == 'agent' &&
          get(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)).data.distributorId == distributorId()) ||
        (request.resource.data.recipientUserId == 'admin@gasbridge.com' &&
          request.resource.data.role == 'admin' && request.resource.data.title == 'Distributor Registration Request')
      );
    }
    function customerNotificationTarget() {
      return role() == 'customer' && request.resource.data.role == 'distributor' &&
        exists(/databases/$(database)/documents/customers/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)).data.role == 'distributor' &&
        get(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)).data.distributorId ==
          get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.distributorId;
    }
    function agentNotificationTarget() {
      return role() == 'agent' && request.resource.data.role == 'distributor' &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)).data.role == 'distributor' &&
        get(/databases/$(database)/documents/users/$(request.resource.data.recipientUserId)).data.distributorId == distributorId();
    }
    function assignedAgentBookingNotificationTarget() {
      let bookingPath = /databases/$(database)/documents/bookings/$(request.resource.data.bookingId);
      return role() == 'agent' && request.resource.data.role == 'customer' &&
        request.resource.data.bookingId is string && exists(bookingPath) &&
        get(bookingPath).data.deliveryAgentId == me().agentId &&
        get(bookingPath).data.customerId == request.resource.data.recipientUserId;
    }
    function validCustomerInventoryReservation(id) {
      let reservation = request.resource.data.lastReservation;
      let bookingPath = /databases/$(database)/documents/bookings/$(reservation.bookingId);
      let booking = getAfter(bookingPath).data;
      return role() == 'customer' && reservation.customerId == request.auth.uid &&
        reservation.bookingId is string && reservation.transactionReference == booking.transactionReference &&
        reservation.cylinderType == booking.cylinderType && reservation.quantity == booking.quantity &&
        id == booking.distributorId && booking.customerId == request.auth.uid &&
        booking.paymentStatus == 'paid' && booking.bookingStatus == 'confirmed' &&
        existsAfter(/databases/$(database)/documents/payments/$(reservation.transactionReference)) &&
        (booking.cylinderType == 'domestic' &&
          resource.data.domestic.available >= booking.quantity &&
          request.resource.data.domestic.available == resource.data.domestic.available - booking.quantity &&
          request.resource.data.domestic.reserved == resource.data.domestic.reserved + booking.quantity ||
         booking.cylinderType == 'commercial' &&
          resource.data.commercial.available >= booking.quantity &&
          request.resource.data.commercial.available == resource.data.commercial.available - booking.quantity &&
         request.resource.data.commercial.reserved == resource.data.commercial.reserved + booking.quantity);
    }
    function validDemoPaymentIntent(bookingId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      return signedIn() && role() == 'customer' && exists(bookingPath) &&
        get(bookingPath).data.customerId == request.auth.uid &&
        get(bookingPath).data.paymentStatus == 'unpaid' &&
        get(bookingPath).data.bookingStatus == 'pending_payment' &&
        request.resource.data.bookingId == bookingId &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.amount == get(bookingPath).data.totalAmount &&
        request.resource.data.confirmationId == bookingId &&
        request.resource.data.token is string && request.resource.data.token.size() >= 32 &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(45, 's');
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid && cleanProfile() &&
        request.resource.data.role in ['customer', 'distributor', 'agent'] &&
        request.resource.data.status == 'pending';
      allow update: if cleanProfile() && (
        (signedIn() && request.auth.uid == uid && profileOwnerUnchanged()) ||
        (admin() && resource.data.role != 'customer') ||
        (role() == 'distributor' && resource.data.role in ['customer', 'agent'] &&
          resource.data.distributorId == distributorId() &&
          ((request.resource.data.status == 'approved' && request.resource.data.approvedBy == request.auth.uid) ||
           (request.resource.data.status == 'rejected' && request.resource.data.rejectedBy == request.auth.uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvalStatus', 'active', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'rejectionReason', 'updatedAt']))
      );
      allow delete: if admin();
    }

    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin() ||
        (role() == 'distributor' && resource.data.distributorId == distributorId()));
      allow create: if signedIn() && request.auth.uid == uid && cleanProfile() && request.resource.data.status == 'pending' &&
        request.resource.data.distributorId is string;
      allow update: if cleanProfile() && (
        (signedIn() && request.auth.uid == uid && request.resource.data.status == resource.data.status &&
          request.resource.data.approvalStatus == resource.data.approvalStatus &&
          request.resource.data.distributorId == resource.data.distributorId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'mobile', 'email', 'address', 'pincode', 'serviceAreaId', 'serviceAreaName', 'cylinderType', 'updatedAt'])) ||
        (role() == 'distributor' && resource.data.distributorId == distributorId() &&
          ((request.resource.data.status == 'approved' && request.resource.data.approvedBy == request.auth.uid) ||
           (request.resource.data.status == 'rejected' && request.resource.data.rejectedBy == request.auth.uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvalStatus', 'active', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'rejectionReason', 'updatedAt']))
      );
      allow delete: if admin();
    }

    match /distributors/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && cleanProfile() && request.resource.data.status == 'pending';
      allow update: if admin() || (role() == 'distributor' && resource.data.userId == request.auth.uid &&
        request.resource.data.status == resource.data.status && request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'businessName', 'contactPerson', 'mobile', 'address', 'city', 'district', 'state', 'updatedAt']));
      allow delete: if admin();
    }

    match /deliveryAgents/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin() ||
        (role() == 'distributor' && resource.data.distributorId == distributorId()));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && cleanProfile() && request.resource.data.status == 'pending';
      allow update: if cleanProfile() && (admin() ||
        (role() == 'distributor' && resource.data.distributorId == distributorId() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvalStatus', 'active', 'dutyStatus', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'rejectionReason', 'updatedAt']) &&
          ((request.resource.data.status == 'approved' && request.resource.data.approvedBy == request.auth.uid) ||
           (request.resource.data.status == 'rejected' && request.resource.data.rejectedBy == request.auth.uid))) ||
        (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.status == resource.data.status &&
          request.resource.data.approvalStatus == resource.data.approvalStatus && request.resource.data.distributorId == resource.data.distributorId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'mobile', 'address', 'pincode', 'vehicleType', 'vehicleNumber', 'dutyStatus', 'updatedAt']))
      );
      allow delete: if admin();
    }

    match /serviceAreas/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /inventory/{id} {
      allow read: if signedIn() && (admin() || (role() == 'distributor' && distributorId() == id) || role() == 'customer');
      allow create: if distributorFor(id) && validInventoryRecord(id) &&
        request.resource.data.keys().hasOnly(['distributorId', 'domestic', 'commercial', 'lowStockThreshold', 'updatedAt']);
      allow update: if validInventoryRecord(id) && (
        (distributorFor(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['domestic', 'commercial', 'lowStockThreshold', 'updatedAt', 'distributorId'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['domestic', 'commercial', 'lastReservation', 'updatedAt']) &&
          validCustomerInventoryReservation(id))
      );
      allow delete: if admin();
    }

    match /bookings/{id} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid &&
        role() == 'customer' && exists(/databases/$(database)/documents/customers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.status == 'approved' &&
        get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.distributorId == request.resource.data.distributorId &&
        request.resource.data.paymentStatus == 'unpaid' && request.resource.data.bookingStatus == 'pending_payment' &&
        request.resource.data.cylinderType in ['domestic', 'commercial'] &&
        request.resource.data.quantity is int && request.resource.data.quantity > 0 && request.resource.data.quantity <= 3 &&
        request.resource.data.unitPrice == (request.resource.data.cylinderType == 'domestic' ? 950 : 1850) &&
        request.resource.data.totalAmount == request.resource.data.unitPrice * request.resource.data.quantity;
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || admin() ||
        (role() == 'distributor' && resource.data.distributorId == distributorId()) ||
        (role() == 'agent' && me().agentId == resource.data.deliveryAgentId));
      allow update: if admin() ||
        (role() == 'distributor' && resource.data.distributorId == distributorId() && resource.data.bookingStatus == 'delivered' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus', 'statusTimeline', 'updatedAt']) &&
          request.resource.data.bookingStatus == 'delivered') ||
        (role() == 'customer' && resource.data.customerId == request.auth.uid &&
          resource.data.paymentStatus == 'unpaid' && resource.data.bookingStatus == 'pending_payment' &&
          request.resource.data.paymentStatus == 'unpaid' && request.resource.data.bookingStatus == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus', 'statusTimeline', 'updatedAt'])) ||
        (role() == 'customer' && resource.data.customerId == request.auth.uid &&
          resource.data.paymentStatus == 'unpaid' && request.resource.data.paymentStatus == 'paid' &&
          request.resource.data.bookingStatus == 'confirmed' && request.resource.data.paymentId.matches('GBPAY-[A-Z0-9]{8}') &&
          request.resource.data.paymentId == request.resource.data.transactionReference &&
          request.resource.data.transactionReference.matches('GBPAY-[A-Z0-9]{8}') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'bookingStatus', 'paymentId', 'transactionReference', 'updatedAt', 'estimatedDelivery'])) ||
        (role() == 'distributor' && resource.data.distributorId == distributorId() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryAgentId', 'deliveryAgentName', 'deliveryAgentMobile', 'deliveryAgentVehicleNumber', 'statusTimeline', 'updatedAt']) &&
          (request.resource.data.deliveryAgentId == resource.data.deliveryAgentId ||
            (resource.data.bookingStatus in ['confirmed', 'processing'] && assignedAgentExists(request.resource.data.deliveryAgentId) && assignedAgentDetailsMatch())) &&
          (request.resource.data.deliveryAgentId == resource.data.deliveryAgentId || request.resource.data.bookingStatus == 'processing') &&
          ((resource.data.bookingStatus == 'confirmed' && request.resource.data.bookingStatus == 'processing') ||
           (resource.data.bookingStatus == 'confirmed' && request.resource.data.bookingStatus == 'confirmed') ||
           (resource.data.bookingStatus == 'processing' && request.resource.data.bookingStatus == 'processing') ||
           (resource.data.bookingStatus == 'processing' && resource.data.deliveryAgentId != '' && request.resource.data.bookingStatus == 'agent_assigned') ||
           request.resource.data.bookingStatus == resource.data.bookingStatus)) ||
        (role() == 'agent' && me().agentId == resource.data.deliveryAgentId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus', 'statusTimeline', 'updatedAt']) &&
          ((resource.data.bookingStatus == 'agent_assigned' && request.resource.data.bookingStatus == 'picked_up') ||
           (resource.data.bookingStatus == 'picked_up' && request.resource.data.bookingStatus == 'out_for_delivery') ||
           (resource.data.bookingStatus == 'out_for_delivery' && request.resource.data.bookingStatus == 'delivered')));
      allow delete: if admin();
    }

    match /payments/{id} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || admin() ||
        (role() == 'distributor' && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.distributorId == distributorId()));
      allow create: if signedIn() && role() == 'customer' && request.resource.data.customerId == request.auth.uid &&
        id.matches('GBPAY-[A-Z0-9]{8}') && request.resource.data.paymentId == id &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.paymentStatus == 'paid' &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.bookingStatus == 'confirmed' &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.transactionReference == id &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.paymentId == id &&
        request.resource.data.amount == getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.totalAmount &&
        request.resource.data.transactionReference == getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.transactionReference &&
        !('cardNumber' in request.resource.data) && !('cvv' in request.resource.data) && !('upiPin' in request.resource.data);
      allow update, delete: if false;
    }

    match /demoPaymentIntents/{bookingId} {
      allow read: if signedIn() && resource.data.customerId == request.auth.uid;
      allow create: if validDemoPaymentIntent(bookingId) &&
        request.resource.data.keys().hasOnly(['bookingId', 'customerId', 'amount', 'confirmationId', 'token', 'expiresAt', 'createdAt']);
      allow update: if resource.data.customerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmationId', 'token', 'expiresAt']) &&
        validDemoPaymentIntent(bookingId);
      allow delete: if false;
    }

    match /demoPaymentConfirmations/{bookingId} {
      function matchingIntent() {
        let intentPath = /databases/$(database)/documents/demoPaymentIntents/$(bookingId);
        let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
        return exists(intentPath) &&
          get(intentPath).data.bookingId == bookingId &&
          get(intentPath).data.confirmationId == bookingId &&
          get(intentPath).data.token == request.resource.data.token &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.confirmationId == bookingId &&
          request.time <= get(intentPath).data.expiresAt &&
          exists(bookingPath) && get(bookingPath).data.paymentStatus == 'unpaid' &&
          get(bookingPath).data.bookingStatus == 'pending_payment';
      }
      allow create: if request.resource.data.keys().hasOnly(['bookingId', 'confirmationId', 'token', 'status']) &&
        request.resource.data.status == 'confirmed' && matchingIntent();
      allow update: if request.resource.data.keys().hasOnly(['bookingId', 'confirmationId', 'token', 'status']) &&
        request.resource.data.status == 'confirmed' && matchingIntent();
      allow read: if signedIn() &&
        get(/databases/$(database)/documents/demoPaymentIntents/$(bookingId)).data.customerId == request.auth.uid &&
        get(/databases/$(database)/documents/demoPaymentIntents/$(bookingId)).data.confirmationId == bookingId;
      allow delete: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.recipientUserId == request.auth.uid || admin());
      allow create: if signedIn() && (admin() || request.resource.data.recipientUserId == request.auth.uid ||
        distributorNotificationTarget() || customerNotificationTarget() || agentNotificationTarget() || assignedAgentBookingNotificationTarget());
      allow update: if signedIn() && resource.data.recipientUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if admin();
    }

    match /auditLogs/{id} {
      allow create: if signedIn() && request.resource.data.actorUserId == request.auth.uid;
      allow read: if admin();
      allow update, delete: if false;
    }
  }
}
